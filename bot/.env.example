# ── Telegram ─────────────────────────────────────────────────────────────
# From @BotFather (/newbot). The bot is publicly reachable by this token,
# so AUTHORIZED_CHAT_ID below is what actually locks it to just you.
TELEGRAM_BOT_TOKEN=

# ── Anthropic (claude-haiku-4-5) ─────────────────────────────────────────
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# ── Nutritionix (free tier) ──────────────────────────────────────────────
# developer.nutritionix.com -> your app credentials
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# ── Access control ───────────────────────────────────────────────────────
# Your personal Telegram chat id. Messages from any other chat are ignored.
# Message the bot once, then watch the logs (the bot logs the chat id of any
# unauthorized message), or message @userinfobot to get your id.
AUTHORIZED_CHAT_ID=

# ── Webhook ──────────────────────────────────────────────────────────────
# Any random string. Used both as the secret URL path segment and as the
# Telegram secret-token header that incoming webhook requests must present.
WEBHOOK_SECRET=

# Public HTTPS origin Telegram will call. On Railway this is auto-derived
# from RAILWAY_PUBLIC_DOMAIN after you "Generate Domain"; set PUBLIC_URL
# explicitly only if you host elsewhere. Example: https://my-bot.up.railway.app
PUBLIC_URL=

# ── Schedule / storage ───────────────────────────────────────────────────
# IANA timezone for the 9 PM daily summary. Change this one var when you
# travel internationally. Default America/Chicago.
TZ=America/Chicago

# SQLite file path. MUST point at an attached Railway volume (mounted at
# /data) so the database survives redeploys.
DB_PATH=/data/foodlog.db

# Railway injects PORT automatically; leave unset locally to default to 3000.
PORT=
