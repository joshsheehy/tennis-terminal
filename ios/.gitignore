# Cordova plugins for Capacitor
capacitor-cordova-ios-plugins

# App/App/public, App/App/capacitor.config.json and App/App/config.xml are
# generated by `npx cap sync` but committed on purpose: the app loads
# tenniscuts.com live, so these never change between builds, and keeping them
# in git means the project opens and runs in Xcode straight after a pull.
