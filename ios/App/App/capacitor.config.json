{
	"appId": "com.tenniscuts.app",
	"appName": "TennisCuts",
	"webDir": "app-shell",
	"server": {
		"url": "https://tenniscuts.com",
		"errorPath": "offline.html"
	},
	"ios": {
		"appendUserAgent": "TennisCutsApp",
		"backgroundColor": "#f7f6f3"
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"banner",
				"sound",
				"list"
			]
		}
	},
	"packageClassList": [
		"PushNotificationsPlugin"
	]
}
