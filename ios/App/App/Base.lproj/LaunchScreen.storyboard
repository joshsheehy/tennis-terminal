    </scenes>
    <resources>
        <image name="Splash" width="112" height="112"/>
        <namedColor name="LaunchBackground">
            <color red="0.969" green="0.965" blue="0.953" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
